# ============================================================================
# Pinned image versions — referenced by docker-compose.yml
# Promotion gates: dev → develop → release/* → main (= production)
# Bump procedure documented in docs/VERSIONING.md.
#
# IMPORTANT: replace digests with the actual sha256 captured during UAT.
# The placeholders below are wired into the compose file but must be resolved
# locally with `docker buildx imagetools inspect <tag>` before first deploy.
# ============================================================================

# ── vLLM ─ GB10 / SM 12.1 / ARM64 / CUDA 13.x ───────────────────────────────
# Community-maintained, fastest track for SM 12.1 patches.
VLLM_IMAGE=hellohal2064/vllm-dgx-spark-gb10:latest
# After UAT, replace the tag form with:
# VLLM_IMAGE=hellohal2064/vllm-dgx-spark-gb10@sha256:REPLACE_WITH_REAL_DIGEST

# Alternative (NVIDIA NGC official aarch64 — uncomment when 25.06+ GA):
# VLLM_IMAGE=nvcr.io/nvidia/vllm:25.06-py3

# ── LiteLLM Gateway ─ multi-arch ────────────────────────────────────────────
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-stable

# ── PostgreSQL ─ multi-arch ─────────────────────────────────────────────────
POSTGRES_IMAGE=postgres:16-alpine

# ── Redis ─ multi-arch ──────────────────────────────────────────────────────
REDIS_IMAGE=redis:7-alpine

# ── Prometheus / Grafana (optional metrics stack) ───────────────────────────
PROM_IMAGE=prom/prometheus:v2.55.1
GRAFANA_IMAGE=grafana/grafana:11.3.0
