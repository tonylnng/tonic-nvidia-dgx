# ============================================================================
# Tonic NVIDIA DGX Spark (GB10) — environment file template
# Copy to .env and fill in real values. Never commit .env to git.
# ============================================================================

# ─── Hugging Face ────────────────────────────────────────────────────────────
# Read-token from https://huggingface.co/settings/tokens
# Only used when a service tries to fetch a model by HF repo-id (not needed
# when models are supplied manually under /data/huggingface/manual).
HF_TOKEN=hf_replace_me

# ─── Model selection ─────────────────────────────────────────────────────────
# Paths inside the vLLM container. /models is mounted read-only from
# ${MANUAL_MODELS_DIR:-/data/huggingface/manual} on the host — place the
# manually-downloaded HF snapshot folder there (see docs/MANUAL_MODEL_UPLOAD.md).
#
# You can also pass an HF repo-id here (e.g. Qwen/Qwen3-30B-A3B-FP8) and vLLM
# will fetch it via HF_TOKEN on first start.
#
# Defaults (used when these vars are unset):
#   QWEN_MAIN_MODEL    = /models/Qwen3-30B-A3B-FP8   (MoE, ~3B active, ~7 GB)
#   QWEN_VISION_MODEL  = /models/Qwen2.5-VL-7B-Instruct-FP4
#   GEMMA_FAST_MODEL   = /models/Gemma-4-31B-IT-NVFP4
#   QWEN_MAIN_MEM_UTIL = 0.30
#
# QWEN_MAIN_MODEL=/models/Qwen3-30B-A3B-FP8
# QWEN_VISION_MODEL=/models/Qwen2.5-VL-7B-Instruct-FP4
# GEMMA_FAST_MODEL=/models/Gemma-4-31B-IT-NVFP4
# QWEN_MAIN_MEM_UTIL=0.30

# Host directory that gets mounted as /models inside each vLLM container.
MANUAL_MODELS_DIR=/data/huggingface/manual

# ─── LiteLLM Master Key ──────────────────────────────────────────────────────
# Admin password for the LiteLLM UI and the /key/generate API.
# Use a long random string. Rotate quarterly.
LITELLM_MASTER_KEY=sk-master-CHANGE-ME-32chars-min

# ─── LiteLLM Salt Key (encrypts virtual keys at rest in Postgres) ────────────
LITELLM_SALT_KEY=sk-salt-CHANGE-ME-32chars-min

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=litellm
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=litellm
DATABASE_URL=postgresql://litellm:CHANGE_ME_strong_password@postgres:5432/litellm

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Optional: cloud fallbacks (uncomment in litellm_config.yaml to enable) ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Tailscale (optional — only if you want LiteLLM to push metrics out) ─────
TAILSCALE_AUTHKEY=

# ─── Storage paths on the Spark NVMe ─────────────────────────────────────────
HF_CACHE_DIR=/data/huggingface
POSTGRES_DATA_DIR=/data/postgres
REDIS_DATA_DIR=/data/redis
LITELLM_LOGS_DIR=/data/litellm-logs
